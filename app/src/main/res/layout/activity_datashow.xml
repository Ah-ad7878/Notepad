<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/show_main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".datashow">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/show_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="24dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/show_back_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_btn"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/update"
            android:textAllCaps="false"
            android:textColor="@color/btn_blue"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/share_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="end"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share Note"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_share"
            app:tint="@color/black" />

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/show_bottom_bar"
        app:layout_constraintTop_toBottomOf="@id/show_toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <EditText
                android:id="@+id/show_note_title_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="@font/slumber"
                android:hint="Title"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:textColor="@color/black"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:text="Note Title" />

            <TextView
                android:id="@+id/show_note_date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:text="October 24, 2023" />

            <EditText
                android:id="@+id/show_note_content_tv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:background="@null"
                android:fontFamily="@font/notesfont"
                android:gravity="top"
                android:hint="Note content..."
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/black"
                android:textSize="18sp"
                tools:text="This is the content of the note." />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/show_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.BottomBar"
        app:strokeColor="@color/gray_border"
        app:strokeWidth="1dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <View
                    android:id="@+id/show_color_white"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/white" />

                <View
                    android:id="@+id/show_color_red"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_red" />

                <View
                    android:id="@+id/show_color_yellow"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_yellow" />

                <View
                    android:id="@+id/show_color_pink"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_pink" />

                <View
                    android:id="@+id/show_color_green"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_green" />

                <View
                    android:id="@+id/show_color_blue"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_blue" />

                <View
                    android:id="@+id/show_color_purple"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_purple" />

                <View
                    android:id="@+id/show_color_orange"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_orange" />

                <View
                    android:id="@+id/show_color_granite"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/granite" />

                <View
                    android:id="@+id/show_color_Aqua"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/Aqua" />

                <View
                    android:id="@+id/show_color_Brown"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/brown" />

            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>