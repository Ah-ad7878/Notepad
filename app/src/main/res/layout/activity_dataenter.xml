<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".dataenter">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="24dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_btn_description"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/black" />

        <ImageButton
            android:id="@+id/ocr_scanner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/camera_btn_description"
            android:padding="8dp"
            android:src="@drawable/baseline_camera_alt_24"
            app:tint="@color/black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_btn"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/btn_blue"
            android:textSize="17sp"
            android:textStyle="bold" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <EditText
                android:id="@+id/note_title_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="@font/titlefont"
                android:hint="@string/title_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:textColor="@color/black"
                android:textColorHint="@color/on_surface_variant"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/current_date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:fontFamily="@font/notesfont"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:text="October 24, 10:30 AM" />

            <EditText
                android:id="@+id/note_content_et"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                android:background="@null"
                android:fontFamily="@font/description"
                android:gravity="top"
                android:hint="@string/content_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/black"
                android:textColorHint="@color/on_surface_variant"
                android:textSize="17sp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.BottomBar"
        app:strokeColor="@color/gray_border"
        app:strokeWidth="1dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <View
                    android:id="@+id/color_white"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/white" />

                <View
                    android:id="@+id/color_red"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_red" />

                <View
                    android:id="@+id/color_yellow"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_yellow" />

                <View
                    android:id="@+id/color_pink"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_pink" />

                <View
                    android:id="@+id/color_green"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_green" />

                <View
                    android:id="@+id/color_blue"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_blue" />

                <View
                    android:id="@+id/color_purple"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_purple" />

                <View
                    android:id="@+id/color_orange"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/note_orange" />

                <View
                    android:id="@+id/color_granite"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/granite" />

                <View
                    android:id="@+id/color_Aqua"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/Aqua" />

                <View
                    android:id="@+id/color_brown"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/circle_color"
                    android:backgroundTint="@color/brown" />

            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>