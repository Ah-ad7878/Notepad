<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.Notepad" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/btn_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_orange</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/gray_light</item>
    </style>

    <style name="Theme.Notepad" parent="Base.Theme.Notepad" />

    <style name="ShapeAppearanceOverlay.App.BottomBar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.Notepad.SearchView" parent="">
        <item name="android:editTextColor">@color/black</item>
        <item name="android:textColorHint">@color/gray_dark</item>
        <item name="colorAccent">@color/btn_blue</item>
        <item name="colorControlNormal">@color/gray_dark</item>
    </style>
</resources>